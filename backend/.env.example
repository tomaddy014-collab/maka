# ATLAS backend env — copy to .env and fill in. NEVER commit the real .env.

# --- Database (single var for local + cloud; Supabase gives you this string) ---
# Local default if unset: sqlite:///./atlas.db
DATABASE_URL=postgresql://postgres:password@localhost:5432/atlas

# --- Single-user auth ---
APP_PASSWORD=change-me                 # the one password that gates the app
JWT_SECRET=generate-a-long-random-string
JWT_EXPIRE_MINUTES=10080               # 7 days

# --- Garmin adapter selection ---
GARMIN_ADAPTER=unofficial              # unofficial | official
GARMIN_EMAIL=you@example.com
GARMIN_PASSWORD=your-garmin-password
# Where garth caches its session tokens so we don't re-login every call:
GARMIN_TOKEN_DIR=./.garmin_session

# --- Official Garmin Health API (Phase: later; the official adapter is a stub) ---
GARMIN_HEALTH_API_KEY=
GARMIN_HEALTH_API_SECRET=

# --- Scheduled sync ---
ENABLE_SCHEDULED_SYNC=false            # true to run the in-process daily sync
SYNC_INTERVAL_HOURS=6

# --- CORS: the frontend origin(s), comma-separated ---
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:8000

# --- Anthropic (Phase 5 cardio engine; server-side only, never in frontend) ---
ANTHROPIC_API_KEY=
